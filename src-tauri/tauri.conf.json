{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "thread-visualizer",
  "version": "1.0.5",
  "identifier": "io.github.thirumalx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Thread Visualizer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBMThFMEIwRjVFMjMyMjYKUldRbU11TDFzT0FZNnZwMXpiVkE2blloVkd2cmxjVW9adEtCM3BWTGJTamlzUHBJT01iL25sNWMK",
      "endpoints": [
        "https://github.com/thirumalx/thread-visualizer/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}